# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loanlens

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT — B2B Users (Bank Admin, Company DSA, Field Agent) ────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_32_chars
JWT_REFRESH_EXPIRES=7d

# ─── JWT — Customer Portal (PortalUser) ────────────────────────────────────────
JWT_PORTAL_ACCESS_SECRET=change_this_portal_access_secret_min_32_chars
JWT_PORTAL_ACCESS_EXPIRES=15m
JWT_PORTAL_REFRESH_SECRET=change_this_portal_refresh_secret_min_32_chars
JWT_PORTAL_REFRESH_EXPIRES=7d

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="LoanLens <noreply@loanlens.in>"

# ─── OpenAI (Week 5) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ─── Agora (Week 8) ────────────────────────────────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ─── Cloudinary (File Uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
