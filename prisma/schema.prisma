// ============================================================
// LoanLens — Prisma Schema (Full Project)
// Database: PostgreSQL  |  ORM: Prisma
// ============================================================
// B2B Roles:  BANK_ADMIN | COMPANY_DSA | FIELD_AGENT
// B2C:        PortalUser (customer portal — separate model)
// ============================================================
// M01 Auth B2B     — User, RefreshToken, PasswordResetToken, EmailVerificationToken
// M02 Bank         — Bank, CompanyBankAgreement
// M03 DSA          — CompanyDSA, FieldAgentDSA, CommissionSplitRule
// M04 Product      — LoanProduct, RateSlab, ProductRateHistory
// M05 Search       — SavedSearch
// M06 AI           — AIConversation
// M07 Compare      — Redis only (no DB model)
// M08 Customer CRM — Customer, LoanApplication
// M09 Commission   — CommissionTransaction, BankDisbursementReport
// M10 Notifications — Notification
// M11 Analytics    — ProductImpression
// M12 Portal Auth  — PortalUser, PortalRefreshToken, PortalPasswordResetToken,
//                    PortalEmailVerificationToken, PortalNotification
// M13 Leads        — Lead, Proposal, ProposalProduct
// M14 Video Calls  — VideoCallSession, AgentAvailabilitySlot
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ENUMS


enum UserRole {
  BANK_ADMIN
  COMPANY_DSA
  FIELD_AGENT
}

enum BankType {
  BANK
  NBFC
  HFC
}

enum LoanType {
  HOME
  PERSONAL
  CAR
  BUSINESS
  GOLD
  LAP
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BOTH
}

enum RateType {
  FIXED
  FLOATING
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CustomerVisibility {
  PRIVATE
  COMPANY
}

enum CustomerStatus {
  NEW
  SEARCHING
  COMPARING
  APPLIED
  DOCS_SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  DOCS_SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
  DISBURSED
}

enum CommissionStatus {
  EXPECTED
  DUE
  INVOICED
  PAID
  DISPUTED
}

enum NotificationType {
  RATE_CHANGE
  NEW_PRODUCT
  APPLICATION_UPDATE
  COMMISSION_UPDATE
  INVITE
  SYSTEM
}

enum DisbursementReportStatus {
  PENDING
  PROCESSED
  FAILED
}

enum LeadStatus {
  PENDING
  ASSIGNED
  PROPOSAL_SENT
  CONFIRMED
  REJECTED
  CLOSED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  CONFIRMED
  REJECTED
}

enum CallPurpose {
  PROPOSAL_DISCUSSION
  DOCUMENT_VERIFICATION
  GENERAL_QUERY
}

enum CallStatus {
  REQUESTED
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PortalNotificationType {
  PROPOSAL_RECEIVED
  CALL_CONFIRMED
  CALL_REMINDER
  APPLICATION_UPDATE
  SYSTEM
}


// M01 — AUTH (B2B)


model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bank       Bank?
  companyDsa CompanyDSA?
  fieldAgent FieldAgentDSA?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  productRateChanges  ProductRateHistory[]
  notifications       Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}


// M02 — BANK


model Bank {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  type          BankType
  logoUrl       String?
  gstin         String?
  licenceNumber String?
  contactEmail  String
  contactPhone  String?
  websiteUrl    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                User                     @relation(fields: [userId], references: [id])
  products            LoanProduct[]
  agreements          CompanyBankAgreement[]
  applications        LoanApplication[]
  commissions         CommissionTransaction[]
  disbursementReports BankDisbursementReport[]

  @@map("banks")
}

model CompanyBankAgreement {
  id                   String   @id @default(cuid())
  companyDsaId         String
  bankId               String
  agreedCommissionRate Float?
  isActive             Boolean  @default(true)
  agreementDate        DateTime @default(now())
  notes                String?

  companyDsa CompanyDSA @relation(fields: [companyDsaId], references: [id])
  bank       Bank       @relation(fields: [bankId], references: [id])

  @@unique([companyDsaId, bankId])
  @@index([companyDsaId])
  @@index([bankId])
  @@map("company_bank_agreements")
}

// ────────────────────────────────────────────────────────────
// M03 — DSA
// ────────────────────────────────────────────────────────────

model CompanyDSA {
  id                String   @id @default(cuid())
  userId            String   @unique
  companyName       String
  gstin             String?
  companyCode       String   @unique
  razorpayContactId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id])
  fieldAgents    FieldAgentDSA[]
  bankAgreements CompanyBankAgreement[]
  splitRules     CommissionSplitRule[]
  customers      Customer[]
  applications   LoanApplication[]
  commissions    CommissionTransaction[]
  leads          Lead[]

  @@map("company_dsas")
}

model FieldAgentDSA {
  id                    String   @id @default(cuid())
  userId                String   @unique
  companyDsaId          String
  fullName              String
  phone                 String
  bankAccountNumber     String?
  ifscCode              String?
  pan                   String?
  razorpayFundAccountId String?
  isActive              Boolean  @default(true)
  joinedAt              DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User                    @relation(fields: [userId], references: [id])
  company         CompanyDSA              @relation(fields: [companyDsaId], references: [id])
  customers       Customer[]
  savedSearches   SavedSearch[]
  applications    LoanApplication[]
  commissions     CommissionTransaction[]
  aiConversations AIConversation[]
  impressions     ProductImpression[]
  assignedLeads   Lead[]
  proposals       Proposal[]
  callSessions    VideoCallSession[]
  availability    AgentAvailabilitySlot[]

  @@index([companyDsaId])
  @@map("field_agent_dsas")
}

model CommissionSplitRule {
  id            String   @id @default(cuid())
  companyDsaId  String
  fieldAgentId  String?
  productId     String?
  agentPercent  Float
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)

  companyDsa CompanyDSA   @relation(fields: [companyDsaId], references: [id])
  product    LoanProduct? @relation(fields: [productId], references: [id])

  @@index([companyDsaId])
  @@index([fieldAgentId])
  @@map("commission_split_rules")
}

// ────────────────────────────────────────────────────────────
// M04 — PRODUCT CATALOG
// ────────────────────────────────────────────────────────────

model LoanProduct {
  id                   String        @id @default(cuid())
  bankId               String
  name                 String
  description          String?
  brochureUrl          String?
  loanType             LoanType
  status               ProductStatus @default(DRAFT)
  serviceableStates    String[]
  rateType             RateType      @default(FIXED)
  rateMin              Float
  rateMax              Float
  minAmount            Float
  maxAmount            Float
  minTenureMonths      Int
  maxTenureMonths      Int
  minMonthlyIncome     Float
  maxMonthlyIncome     Float?
  minAge               Int
  maxAge               Int
  acceptedEmployment   EmploymentType[]
  minEmploymentYears   Float
  minCibilScore        Int
  processingFeePercent Float         @default(0)
  commissionPercent    Float
  commissionPayoutDays Int           @default(30)
  commissionNotes      String?
  requiredDocuments    String[]
  ltvPercent           Float?
  propertyTypes        String[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  bank         Bank                    @relation(fields: [bankId], references: [id])
  rateSlabs    RateSlab[]
  rateHistory  ProductRateHistory[]
  applications LoanApplication[]
  commissions  CommissionTransaction[]
  splitRules   CommissionSplitRule[]
  impressions  ProductImpression[]

  @@index([bankId])
  @@index([loanType])
  @@index([status])
  @@map("loan_products")
}

model RateSlab {
  id          String  @id @default(cuid())
  productId   String
  minAmount   Float
  maxAmount   Float
  ratePercent Float
  label       String?

  product LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("rate_slabs")
}

model ProductRateHistory {
  id          String   @id @default(cuid())
  productId   String
  oldRateMin  Float?
  oldRateMax  Float?
  newRateMin  Float
  newRateMax  Float
  changedById String
  notes       String?
  changedAt   DateTime @default(now())

  product   LoanProduct @relation(fields: [productId], references: [id])
  changedBy User        @relation(fields: [changedById], references: [id])

  @@index([productId])
  @@map("product_rate_history")
}

// ────────────────────────────────────────────────────────────
// M05 — SMART SEARCH
// ────────────────────────────────────────────────────────────

model SavedSearch {
  id           String   @id @default(cuid())
  fieldAgentId String
  customerId   String?
  label        String?
  searchInput  Json
  resultCount  Int
  createdAt    DateTime @default(now())

  fieldAgent  FieldAgentDSA       @relation(fields: [fieldAgentId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  impressions ProductImpression[]

  @@index([fieldAgentId])
  @@index([customerId])
  @@map("saved_searches")
}

// ────────────────────────────────────────────────────────────
// M06 — AI ADVISOR
// ────────────────────────────────────────────────────────────

model AIConversation {
  id                String   @id @default(cuid())
  fieldAgentId      String
  customerId        String?
  messages          Json
  productContextIds String[]
  createdAt         DateTime @default(now())
  lastMessageAt     DateTime @default(now()) @updatedAt

  fieldAgent FieldAgentDSA @relation(fields: [fieldAgentId], references: [id])
  customer   Customer?     @relation(fields: [customerId], references: [id])

  @@index([fieldAgentId])
  @@map("ai_conversations")
}

// ────────────────────────────────────────────────────────────
// M08 — CUSTOMER CRM
// ────────────────────────────────────────────────────────────

model Customer {
  id                String             @id @default(cuid())
  fieldAgentId      String
  companyDsaId      String?
  fullName          String
  phone             String
  email             String?
  source            String?
  visibility        CustomerVisibility @default(PRIVATE)
  monthlyIncome     Float
  employmentType    EmploymentType
  employmentYears   Float
  cibilScore        Int
  cibilCheckedAt    DateTime
  existingEmiAmount Float              @default(0)
  city              String?
  state             String?
  status            CustomerStatus     @default(NEW)
  notes             String?
  nextFollowUpDate  DateTime?
  portalLeadId      String?            @unique
  isPortalCustomer  Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  fieldAgent      FieldAgentDSA    @relation(fields: [fieldAgentId], references: [id])
  companyDsa      CompanyDSA?      @relation(fields: [companyDsaId], references: [id])
  applications    LoanApplication[]
  savedSearches   SavedSearch[]
  aiConversations AIConversation[]
  portalLead      Lead?            @relation(fields: [portalLeadId], references: [id])

  @@index([fieldAgentId])
  @@index([companyDsaId])
  @@index([status])
  @@index([phone])
  @@map("customers")
}

model LoanApplication {
  id              String            @id @default(cuid())
  customerId      String
  productId       String
  fieldAgentId    String
  companyDsaId    String
  bankId          String
  appliedAmount   Float
  appliedAt       DateTime          @default(now())
  status          ApplicationStatus @default(APPLIED)
  bankRefNumber   String?
  disbursedAmount Float?
  disbursedAt     DateTime?
  notes           String?
  portalLeadId    String?
  updatedAt       DateTime          @updatedAt

  customer   Customer               @relation(fields: [customerId], references: [id])
  product    LoanProduct            @relation(fields: [productId], references: [id])
  fieldAgent FieldAgentDSA          @relation(fields: [fieldAgentId], references: [id])
  companyDsa CompanyDSA             @relation(fields: [companyDsaId], references: [id])
  bank       Bank                   @relation(fields: [bankId], references: [id])
  commission CommissionTransaction?

  @@index([customerId])
  @@index([fieldAgentId])
  @@index([companyDsaId])
  @@index([bankId])
  @@index([status])
  @@index([portalLeadId])
  @@map("loan_applications")
}

// ────────────────────────────────────────────────────────────
// M09 — COMMISSION
// ────────────────────────────────────────────────────────────

model CommissionTransaction {
  id                String           @id @default(cuid())
  loanApplicationId String           @unique
  fieldAgentId      String
  companyDsaId      String
  bankId            String
  productId         String
  appliedAmount     Float
  commissionRate    Float
  grossAmount       Float
  agentEarning      Float
  companyEarning    Float
  status            CommissionStatus @default(EXPECTED)
  expectedPayDate   DateTime?
  actualPayDate     DateTime?
  razorpayPayoutId  String?
  tdsAmount         Float?
  tdsPercent        Float?
  gstInvoiceNumber  String?
  gstInvoiceUrl     String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id])
  fieldAgent      FieldAgentDSA   @relation(fields: [fieldAgentId], references: [id])
  companyDsa      CompanyDSA      @relation(fields: [companyDsaId], references: [id])
  bank            Bank            @relation(fields: [bankId], references: [id])
  product         LoanProduct     @relation(fields: [productId], references: [id])

  @@index([fieldAgentId])
  @@index([companyDsaId])
  @@index([bankId])
  @@index([status])
  @@map("commission_transactions")
}

model BankDisbursementReport {
  id            String                   @id @default(cuid())
  bankId        String
  csvUrl        String
  totalRows     Int
  matchedRows   Int                      @default(0)
  unmatchedRows Int                      @default(0)
  status        DisbursementReportStatus @default(PENDING)
  uploadedAt    DateTime                 @default(now())
  processedAt   DateTime?

  bank Bank @relation(fields: [bankId], references: [id])

  @@index([bankId])
  @@map("bank_disbursement_reports")
}

// ────────────────────────────────────────────────────────────
// M10 — NOTIFICATIONS (B2B)
// ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  isRead    Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ────────────────────────────────────────────────────────────
// M11 — ANALYTICS
// ────────────────────────────────────────────────────────────

model ProductImpression {
  id           String   @id @default(cuid())
  productId    String
  fieldAgentId String
  searchId     String?
  impressedAt  DateTime @default(now())

  product    LoanProduct   @relation(fields: [productId], references: [id])
  fieldAgent FieldAgentDSA @relation(fields: [fieldAgentId], references: [id])
  search     SavedSearch?  @relation(fields: [searchId], references: [id])

  @@index([productId])
  @@index([fieldAgentId])
  @@index([impressedAt])
  @@map("product_impressions")
}

// ────────────────────────────────────────────────────────────
// M12 — CUSTOMER PORTAL AUTH
// ────────────────────────────────────────────────────────────

model PortalUser {
  id                     String          @id @default(cuid())
  fullName               String
  phone                  String
  email                  String          @unique
  passwordHash           String
  isActive               Boolean         @default(true)
  emailVerified          Boolean         @default(false)
  snapshotIncome         Float?
  snapshotEmploymentType EmploymentType?
  snapshotCibilScore     Int?
  snapshotExistingEmi    Float?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  refreshTokens       PortalRefreshToken[]
  passwordResetTokens PortalPasswordResetToken[]
  emailVerifyTokens   PortalEmailVerificationToken[]
  leads               Lead[]
  notifications       PortalNotification[]

  @@map("portal_users")
}

model PortalRefreshToken {
  id           String    @id @default(cuid())
  token        String    @unique
  portalUserId String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_refresh_tokens")
}

model PortalPasswordResetToken {
  id           String   @id @default(cuid())
  token        String   @unique
  portalUserId String
  expiresAt    DateTime
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_password_reset_tokens")
}

model PortalEmailVerificationToken {
  id           String   @id @default(cuid())
  token        String   @unique
  portalUserId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_email_verification_tokens")
}

model PortalNotification {
  id           String                 @id @default(cuid())
  portalUserId String
  type         PortalNotificationType
  title        String
  body         String
  metadata     Json?
  isRead       Boolean                @default(false)
  emailSent    Boolean                @default(false)
  createdAt    DateTime               @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@index([portalUserId, isRead])
  @@map("portal_notifications")
}

// ────────────────────────────────────────────────────────────
// M13 — LEADS & PROPOSALS
// ────────────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(cuid())
  portalUserId   String
  companyDsaId   String
  fieldAgentId   String?
  productId      String?
  loanType       LoanType
  requiredAmount Float
  customerNote   String?
  monthlyIncome  Float
  cibilScore     Int
  employmentType EmploymentType
  existingEmi    Float      @default(0)
  state          String?
  status         LeadStatus @default(PENDING)
  assignedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  portalUser   PortalUser         @relation(fields: [portalUserId], references: [id])
  companyDsa   CompanyDSA         @relation(fields: [companyDsaId], references: [id])
  fieldAgent   FieldAgentDSA?     @relation(fields: [fieldAgentId], references: [id])
  proposals    Proposal[]
  crmCustomer  Customer?
  callSessions VideoCallSession[]

  @@index([portalUserId])
  @@index([companyDsaId])
  @@index([fieldAgentId])
  @@index([status])
  @@map("leads")
}

model Proposal {
  id           String         @id @default(cuid())
  leadId       String
  fieldAgentId String
  agentNote    String?
  status       ProposalStatus @default(DRAFT)
  sentAt       DateTime?
  viewedAt     DateTime?
  confirmedAt  DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lead                 Lead              @relation(fields: [leadId], references: [id])
  fieldAgent           FieldAgentDSA     @relation(fields: [fieldAgentId], references: [id])
  recommendedProducts  ProposalProduct[]

  @@index([leadId])
  @@index([fieldAgentId])
  @@map("proposals")
}

model ProposalProduct {
  id           String  @id @default(cuid())
  proposalId   String
  productId    String
  productName  String
  bankName     String
  appliedRate  Float
  estimatedEmi Float
  loanAmount   Float
  tenureMonths Int
  agentReason  String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_products")
}

// ────────────────────────────────────────────────────────────
// M14 — VIDEO CALL SESSIONS
// ────────────────────────────────────────────────────────────

model VideoCallSession {
  id                 String      @id @default(cuid())
  leadId             String
  fieldAgentId       String
  portalUserId       String?
  purpose            CallPurpose
  status             CallStatus  @default(REQUESTED)
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  durationSeconds    Int?
  channelName        String      @unique @default(cuid())
  provider           String      @default("agora")
  agentNotes         String?
  customerNote       String?
  preferredTime      String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lead       Lead          @relation(fields: [leadId], references: [id])
  fieldAgent FieldAgentDSA @relation(fields: [fieldAgentId], references: [id])

  @@index([leadId])
  @@index([fieldAgentId])
  @@index([status])
  @@index([scheduledAt])
  @@map("video_call_sessions")
}

model AgentAvailabilitySlot {
  id           String    @id @default(cuid())
  fieldAgentId String
  slotDate     DateTime
  slotTime     String
  isBooked     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  fieldAgent FieldAgentDSA @relation(fields: [fieldAgentId], references: [id], onDelete: Cascade)

  @@index([fieldAgentId])
  @@index([slotDate])
  @@index([fieldAgentId, slotDate, isBooked])
  @@map("agent_availability_slots")
}
