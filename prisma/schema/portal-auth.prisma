// ─────────────────────────────────────────────────
// M12 — Customer Portal Auth
// Models: PortalUser, PortalRefreshToken,
//         PortalPasswordResetToken,
//         PortalEmailVerificationToken,
//         PortalNotification
// ─────────────────────────────────────────────────

model PortalUser {
  id                     String          @id @default(cuid())
  fullName               String
  phone                  String?
  email                  String          @unique
  passwordHash           String?
  googleId               String?         @unique
  isActive               Boolean         @default(true)
  emailVerified          Boolean         @default(false)
  snapshotIncome         Float?
  snapshotEmploymentType EmploymentType?
  snapshotCibilScore     Int?
  snapshotExistingEmi    Float?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  refreshTokens       PortalRefreshToken[]
  passwordResetTokens PortalPasswordResetToken[]
  emailVerifyTokens   PortalEmailVerificationToken[]
  leads               Lead[]
  notifications       PortalNotification[]

  @@map("portal_users")
}

model PortalRefreshToken {
  id           String    @id @default(cuid())
  token        String    @unique
  portalUserId String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_refresh_tokens")
}

model PortalPasswordResetToken {
  id           String   @id @default(cuid())
  token        String   @unique
  portalUserId String
  expiresAt    DateTime
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_password_reset_tokens")
}

model PortalEmailVerificationToken {
  id           String   @id @default(cuid())
  token        String   @unique
  portalUserId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@map("portal_email_verification_tokens")
}

model PortalNotification {
  id           String                 @id @default(cuid())
  portalUserId String
  type         PortalNotificationType
  title        String
  body         String
  metadata     Json?
  isRead       Boolean                @default(false)
  emailSent    Boolean                @default(false)
  createdAt    DateTime               @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
  @@index([portalUserId, isRead])
  @@map("portal_notifications")
}
