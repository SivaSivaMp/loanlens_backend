// ─────────────────────────────────────────────────
// M08 — Customer CRM
// Models: Customer, LoanApplication
// ─────────────────────────────────────────────────

model Customer {
  id                String             @id @default(cuid())
  fieldAgentId      String
  companyDsaId      String?
  fullName          String
  phone             String
  email             String?
  source            String?
  visibility        CustomerVisibility @default(PRIVATE)
  monthlyIncome     Float
  employmentType    EmploymentType
  employmentYears   Float
  cibilScore        Int
  cibilCheckedAt    DateTime
  existingEmiAmount Float              @default(0)
  city              String?
  state             String?
  status            CustomerStatus     @default(NEW)
  notes             String?
  nextFollowUpDate  DateTime?
  portalLeadId      String?            @unique
  isPortalCustomer  Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  fieldAgent      FieldAgentDSA    @relation(fields: [fieldAgentId], references: [id])
  companyDsa      CompanyDSA?      @relation(fields: [companyDsaId], references: [id])
  applications    LoanApplication[]
  savedSearches   SavedSearch[]
  aiConversations AIConversation[]
  portalLead      Lead?            @relation(fields: [portalLeadId], references: [id])

  @@index([fieldAgentId])
  @@index([companyDsaId])
  @@index([status])
  @@index([phone])
  @@map("customers")
}

model LoanApplication {
  id              String            @id @default(cuid())
  customerId      String
  productId       String
  fieldAgentId    String
  companyDsaId    String
  bankId          String
  appliedAmount   Float
  appliedAt       DateTime          @default(now())
  status          ApplicationStatus @default(APPLIED)
  bankRefNumber   String?
  disbursedAmount Float?
  disbursedAt     DateTime?
  notes           String?
  portalLeadId    String?
  updatedAt       DateTime          @updatedAt

  customer   Customer               @relation(fields: [customerId], references: [id])
  product    LoanProduct            @relation(fields: [productId], references: [id])
  fieldAgent FieldAgentDSA          @relation(fields: [fieldAgentId], references: [id])
  companyDsa CompanyDSA             @relation(fields: [companyDsaId], references: [id])
  bank       Bank                   @relation(fields: [bankId], references: [id])
  commission CommissionTransaction?

  @@index([customerId])
  @@index([fieldAgentId])
  @@index([companyDsaId])
  @@index([bankId])
  @@index([status])
  @@index([portalLeadId])
  @@map("loan_applications")
}
